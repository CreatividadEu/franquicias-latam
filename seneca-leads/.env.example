# Postgres (Supabase). Pooled URL for app/runtime, direct URL for migrations.
#
# IMPORTANT for Supabase + Prisma: the pooled URL MUST include
#   ?pgbouncer=true&connection_limit=1
# Otherwise Prisma's prepared statements collide across pgbouncer-pooled
# connections ("prepared statement s0 already exists").
#
# Example (shared pooler, IPv4-native, free):
#   DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-1-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.<ref>:<pass>@aws-1-us-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# Phase 1
SERPAPI_KEY=

# Phase 2
APIFY_TOKEN=

# Phase 3
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Phase 4
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAILS=

# Phase 5
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TELEGRAM_BOT_TOKEN=
ALERT_WEBHOOK_URL=
