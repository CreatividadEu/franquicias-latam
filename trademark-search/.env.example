# Base de datos
DB_USER=trademark_user
DB_PASSWORD=your_secure_password_here

# SIPI (cuenta en sipi.sic.gov.co - registro gratuito)
SIPI_USERNAME=tu_usuario_sipi@email.com
SIPI_PASSWORD=tu_password_sipi

# Redis
REDIS_URL=redis://redis:6379/0

# API URL (para el frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email para alertas (opcional - usando Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=alertas@tumarca.com
