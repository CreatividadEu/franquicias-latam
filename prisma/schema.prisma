generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────

enum UserRole {
  ADMIN
  FRANCHISE_OWNER
}

enum InvestmentRange {
  RANGE_50K_100K
  RANGE_100K_200K
  RANGE_200K_PLUS
}

enum ExperienceLevel {
  INVERSOR
  OPERACIONES
  VENTAS
  OTRO
}

enum FranchisePlanTier {
  BASIC
  PLUS
  PRO
}

// ── Landing Page System ─────────────────────────────
enum PlanTier {
  BASIC
  GROWTH
  ALL_IN
}

enum ListingType {
  ACTIVE_FRANCHISE
  EXTERNAL_FRANCHISE
  IDENTIFIED_BRAND
}

enum VerificationStatus {
  VERIFIED_BY_FL
  NOT_VERIFIED
  UNDER_REVIEW
}

enum InterestCtaMode {
  APPLY
  REQUEST_INFO
  EXPLORE_BRAND
  JOIN_INTEREST
}

// ── Lookup Tables ──────────────────────────────────

model Sector {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  emoji      String
  franchises Franchise[]
  leads      Lead[]      @relation("LeadSectors")
  createdAt  DateTime    @default(now())

  @@map("sectors")
}

model Country {
  id                String              @id @default(cuid())
  name              String              @unique
  code              String              @unique
  phoneCode         String
  flag              String
  franchiseCoverage FranchiseCoverage[]
  leads             Lead[]
  createdAt         DateTime            @default(now())

  @@map("countries")
}

// ── Core Models ────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(FRANCHISE_OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Franchise {
  id                String              @id @default(cuid())
  name              String
  description       String
  logo              String?
  video             String?
  investmentMin     Float
  investmentMax     Float
  sectorId          String
  sector            Sector              @relation(fields: [sectorId], references: [id])
  slug              String?             @unique
  contactEmail      String?
  featured          Boolean             @default(false)
  active            Boolean             @default(true)
  coverageCountries FranchiseCoverage[]
  matches           LeadFranchiseMatch[]
  profile           FranchiseProfile?
  featureFlags      FranchiseFeatureFlags?
  botConfig         FranchiseBotConfig?
  botFaqs           FranchiseBotFaq[]
  sandboxSessions   SandboxSession[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // ── Landing Page System (additive) ────────────────
  planTier          PlanTier            @default(BASIC)
  published         Boolean             @default(false)
  headline          String?
  subheadline       String?
  shortDescription  String?
  longDescription   String?
  logoUrl           String?
  heroImageUrl      String?
  youtubeUrl        String?
  brochureUrl       String?
  bookingUrl        String?
  credibilityLine   String?
  foundingYear      Int?
  cta1Label         String?
  cta1Url           String?
  cta2Label         String?
  cta2Url           String?
  ebitdaReference   String?
  paybackMonths     Int?
  royaltyInfo       String?
  operatorProfile   String?
  canonEntrada      Float?

  businessModels    FranchiseBusinessModel[]
  media             FranchiseMedia[]
  faqs              FranchiseFaq[]
  moduleConfig      FranchiseModuleConfig?
  automationConfig  FranchiseAutomationConfig?
  listingType       ListingType          @default(ACTIVE_FRANCHISE)
  verificationStatus VerificationStatus  @default(VERIFIED_BY_FL)
  editorialBadge    String?
  publicInterestCount Int                @default(0)
  publicInterestEnabled Boolean          @default(false)
  publicInterestLabel String?
  interestCtaMode   InterestCtaMode      @default(APPLY)
  availabilityLabel String?
  statusDisclaimer  String?
  showApplicationForm Boolean            @default(true)
  showFinancialData Boolean              @default(true)
  showVerifiedBadge Boolean              @default(false)

  @@map("franchises")
}

model FranchiseBusinessModel {
  id            String    @id @default(cuid())
  franchiseId   String
  franchise     Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  name          String
  size          String?
  investmentMin Float?
  investmentMax Float?
  ebitda        String?
  paybackMonths Int?
  roiAnnual     Float?
  imageUrl      String?
  description   String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([franchiseId])
  @@map("franchise_business_models")
}

model FranchiseMedia {
  id          String    @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  type        String
  url         String
  label       String?
  altText     String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([franchiseId])
  @@map("franchise_media")
}

model FranchiseFaq {
  id          String    @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  order       Int       @default(0)

  @@index([franchiseId])
  @@map("franchise_faqs")
}

model FranchiseModuleConfig {
  id                    String    @id @default(cuid())
  franchiseId           String    @unique
  franchise             Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  heroEnabled           Boolean   @default(true)
  videoEnabled          Boolean   @default(false)
  galleryEnabled        Boolean   @default(false)
  businessModelsEnabled Boolean   @default(false)
  financialsEnabled     Boolean   @default(true)
  faqEnabled            Boolean   @default(false)
  brochureEnabled       Boolean   @default(false)
  bookingEnabled        Boolean   @default(false)
  chatbotEnabled        Boolean   @default(false)
  nurturingEnabled      Boolean   @default(false)
  showVerifiedBadge     Boolean   @default(false)

  @@map("franchise_module_configs")
}

model FranchiseAutomationConfig {
  id                  String    @id @default(cuid())
  franchiseId         String    @unique
  franchise           Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  enabled             Boolean   @default(false)
  bookingUrl          String?
  nurtureSequenceId   String?
  webhookUrl          String?
  crmDestination      String?
  calendlyRoutingMode String?

  @@map("franchise_automation_configs")
}

model FranchiseProfile {
  id              String    @id @default(uuid())
  franchiseId      String    @unique
  franchise        Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  headline         String    @default("")
  subheadline      String    @default("")
  heroImageUrl     String?
  heroVideoUrl     String?
  galleryUrls      String[]  @default([])
  brochureUrl      String?
  investmentMin    Float?
  investmentMax    Float?
  countryCoverage  String?

  // Hero section
  heroTitle        String?
  heroSubtitle     String?
  heroCtaLabel     String?
  heroStats        Json?

  // Reviews badge
  showReviewsBadge  Boolean   @default(false)
  reviewRating      Float?
  reviewBadgeLabel  String?
  reviewAvatarUrls  Json?

  // Navbar
  showFranchiseLogo Boolean   @default(false)
  franchiseLogoUrl  String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("franchise_profiles")
}

model FranchiseFeatureFlags {
  franchiseId      String            @id
  franchise        Franchise         @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  showVideo        Boolean           @default(false)
  showGallery      Boolean           @default(true)
  showTestimonials Boolean           @default(false)
  showKpis         Boolean           @default(true)
  showBot          Boolean           @default(false)
  showDownloads    Boolean           @default(false)
  showContactForm  Boolean           @default(true)
  planTier         FranchisePlanTier @default(BASIC)
  updatedAt        DateTime          @updatedAt

  @@map("franchise_feature_flags")
}

model FranchiseBotConfig {
  franchiseId         String    @id
  franchise           Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  enabled             Boolean   @default(false)
  systemInstructions  String    @default("")
  fallbackMessage     String    @default("")
  tone                String?
  botMode             String?   @default("guided")
  aiProvider          String?   @default("claude")
  aiModel             String?
  maxMessagesPerConvo Int?      @default(20)
  maxConvosPerMonth   Int?      @default(500)
  updatedAt           DateTime  @updatedAt

  @@map("franchise_bot_configs")
}

model FranchiseBotFaq {
  id          String    @id @default(uuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  priority    Int       @default(0)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([franchiseId])
  @@index([franchiseId, priority])
  @@map("franchise_bot_faqs")
}

model FranchiseCoverage {
  id          String    @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  countryId   String
  country     Country   @relation(fields: [countryId], references: [id])

  @@unique([franchiseId, countryId])
  @@map("franchise_coverage")
}

model Lead {
  id              String          @id @default(cuid())
  name            String
  email           String
  phone           String
  phoneVerified   Boolean         @default(false)
  countryId       String
  country         Country         @relation(fields: [countryId], references: [id])
  sectors         Sector[]        @relation("LeadSectors")
  investmentRange InvestmentRange
  experienceLevel ExperienceLevel
  viewed          Boolean         @default(false)
  matches         LeadFranchiseMatch[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([email])
  @@index([phone])
  @@map("leads")
}

model LeadFranchiseMatch {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  score       Int
  contacted   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([leadId, franchiseId])
  @@map("lead_franchise_matches")
}

// ── Form Leads (landing page qualification form) ────────────────────────────

model FormLead {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  investmentRange String
  city            String?
  experience      String?
  franchiseSlug   String
  listingSlug     String?
  listingType     ListingType @default(ACTIVE_FRANCHISE)
  sourceType      String   @default("franchise_application")
  editorialBadge  String?
  cityInterest    String?
  country         String?
  message         String?
  landingSource   String   @default("landing-form")
  type            String   @default("form")
  createdAt       DateTime @default(now())

  @@index([franchiseSlug])
  @@index([listingSlug])
  @@index([listingType])
  @@index([sourceType])
  @@index([email])
  @@map("form_leads")
}

model SmsVerification {
  id                   String   @id @default(cuid())
  phone                String
  code                 String
  channel              String?  @default("sms")
  attempts             Int      @default(0)
  verified             Boolean  @default(false)
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  providerSid          String?  @unique
  providerStatus       String?
  providerErrorCode    String?
  providerErrorMessage String?
  lastStatusAt         DateTime?

  @@index([phone, createdAt])
  @@map("sms_verifications")
}

// ── SAJÚ Franchise Command Center ───────────────────────────────────────────
// Centro de mando interno de la expansión internacional de Sajú: CRM de leads,
// esfuerzos por canal y agenda institucional. Todo el namespace va prefijado
// `Saju` para poder replicar el módulo por marca más adelante.

enum SajuStage {
  PROSPECTO
  CONTACTADO
  MATERIAL_ENVIADO
  PRESENTADO
  EVALUACION_INTERNA // decisión en familia / comité — etapa real y crítica en este pipeline
  NEGOCIACION
  FIRMADO
}

enum SajuLeadStatus {
  ACTIVO
  PAUSADO
  GANADO
  PERDIDO
}

enum SajuLeadType {
  PUNTO_UNICO
  MULTI_UNIDAD
  MASTER_FRANQUICIA
}

enum SajuInterest {
  ALTO
  MEDIO
  BAJO
}

enum SajuChannel {
  OUTREACH_SELECTIVO
  PR
  REELS_ADS
  LINKEDIN
  LANDING_FORM
}

enum SajuEffortStatus {
  PLANEADO
  EN_CURSO
  COMPLETADO
}

enum SajuEventType {
  NOTA
  TOUCHPOINT
  CAMBIO_ETAPA
  REUNION
}

enum SajuMilestoneStatus {
  PROXIMO
  REALIZADO
  REPROGRAMADO
}

model SajuLead {
  id             String          @id @default(cuid())
  name           String
  company        String? // empresa / contexto
  role           String?
  country        String // ISO-3166 alpha-2: PA, GT, ES
  city           String?
  type           SajuLeadType    @default(PUNTO_UNICO)
  stage          SajuStage       @default(PROSPECTO)
  status         SajuLeadStatus  @default(ACTIVO)
  interest       SajuInterest    @default(MEDIO)
  keyInsight     String? // palanca de cierre
  nextAction     String?
  nextActionDate DateTime?
  source         SajuChannel?
  notes          String?
  events         SajuLeadEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([name, country]) // idempotencia del seed
  @@index([country, stage])
  @@map("saju_leads")
}

model SajuLeadEvent {
  id          String        @id @default(cuid())
  lead        SajuLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  type        SajuEventType
  description String
  occurredAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([leadId, occurredAt])
  @@map("saju_lead_events")
}

model SajuChannelEffort {
  id          String           @id @default(cuid())
  channel     SajuChannel
  country     String? // null = global
  title       String
  outlet      String? // Forbes, equivalente local a La República, etc.
  description String?
  status      SajuEffortStatus @default(PLANEADO)
  plannedFor  DateTime?
  metrics     Json? // reach, leads_generated, spend — flexible
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Sin unique sobre [channel, title]: el mismo esfuerzo se repite con idéntico
  // título en varios países (p. ej. la pauta PR de Forbes en PA y en GT), y el
  // país no puede entrar en la clave porque los globales lo tienen a NULL —
  // Postgres trata cada NULL como distinto y la idempotencia se rompería.
  // El seed es idempotente por id fijo; la UI evita duplicados por canal+país.
  @@index([channel, status])
  @@map("saju_channel_efforts")
}

model SajuMilestone {
  id          String              @id @default(cuid())
  title       String
  counterpart String // persona + cargo
  org         String?
  country     String?
  date        DateTime
  tentative   Boolean             @default(false)
  status      SajuMilestoneStatus @default(PROXIMO)
  notes       String?

  @@unique([title, date])
  @@index([date])
  @@map("saju_milestones")
}

// ── Sandbox — microsite interactivo por cliente (/sandbox/[slug]) ───────────
// Namespace `sandbox_*`, aditivo. Una sesión = un prospecto; los documentos
// crudos viven en Storage (bucket privado) y NUNCA llegan a la ruta pública:
// el cliente solo recibe los campos de marca de la sesión + SandboxPreload.

enum SandboxStatus {
  DRAFT
  READY
  LIVE
  DONE
  ARCHIVED
}

enum SandboxSector {
  RESTAURANTE
  RETAIL
  SERVICIOS
  OTRO
}

enum SandboxLocale {
  ES
  EN
}

enum SandboxAssetKind {
  MENU
  CATALOG
  PRICE_LIST
  SALES_NOTES
  OPEX_NOTES
  OSINT
  MARKETING_AUDIT
  OTHER
}

enum SandboxExtractionStatus {
  PENDING
  RUNNING
  DONE
  ERROR
}

enum SandboxPhase {
  INTRO
  ESTRATEGIA
  FINANZAS
  OPERACIONES
  LEGAL
  MARKETING
  REPORTE
}

model SandboxSession {
  id              String        @id @default(cuid())
  /// Slug público no adivinable (base58, 12 chars). Es la única llave de acceso.
  slug            String        @unique
  /// PIN opcional de 4 dígitos. Texto plano a propósito: el consultor tiene que
  /// poder leerlo para compartirlo; es fricción de enlace, no autenticación.
  pin             String?
  status          SandboxStatus @default(DRAFT)
  franchiseId     String?
  franchise       Franchise?    @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  brandName       String
  sector          SandboxSector @default(RESTAURANTE)
  country         String
  city            String?
  logoUrl         String?
  accentColor     String        @default("#00F0FF")
  consultantName  String?
  scheduledAt     DateTime?
  locale          SandboxLocale @default(ES)
  /// Quick-form de marketing del admin (IG, seguidores, cadencia, web, GBP, pauta).
  marketingInputs Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assets  SandboxAsset[]
  preload SandboxPreload?
  events  SandboxEvent[]
  result  SandboxResult?
  aiCache SandboxAiCache[]

  @@index([status])
  @@index([franchiseId])
  @@map("sandbox_sessions")
}

model SandboxAsset {
  id               String                  @id @default(cuid())
  sessionId        String
  session          SandboxSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind             SandboxAssetKind        @default(OTHER)
  storagePath      String
  originalName     String
  mime             String
  sizeBytes        Int                     @default(0)
  uploadedAt       DateTime                @default(now())
  extractedJson    Json?
  extractionStatus SandboxExtractionStatus @default(PENDING)
  extractionError  String?

  @@index([sessionId])
  @@map("sandbox_assets")
}

/// Una fila por sesión: salida normalizada del preprocesamiento (§3).
model SandboxPreload {
  id           String         @id @default(cuid())
  sessionId    String         @unique
  session      SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  offering     Json
  pains        Json
  marketing    Json
  opexSkeleton Json
  generatedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("sandbox_preloads")
}

/// Log append-only de interacciones del cliente (replay + reporte).
model SandboxEvent {
  id        String         @id @default(cuid())
  sessionId String
  session   SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  phase     SandboxPhase
  type      String
  payload   Json?
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
  @@map("sandbox_events")
}

/// Resultado calculado al final: los take-home de cada fase.
model SandboxResult {
  id              String         @id @default(cuid())
  sessionId       String         @unique
  session         SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  readinessScores Json?
  headline        String?
  route           Json?
  financials      Json?
  chosenPain      Json?
  chosenIdea      Json?
  manual          Json?
  legalChecklist  Json?
  reportPdfPath   String?
  sentToEmail     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("sandbox_results")
}

/// Cache por sesión de las llamadas a Claude, clave = tipo + hash de inputs
/// (reabrir una fase no vuelve a generar).
model SandboxAiCache {
  id        String         @id @default(cuid())
  sessionId String
  session   SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      String
  inputHash String
  model     String
  response  Json
  createdAt DateTime       @default(now())

  @@unique([sessionId, kind, inputHash])
  @@map("sandbox_ai_cache")
}
