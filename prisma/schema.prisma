generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────

enum UserRole {
  ADMIN
  FRANCHISE_OWNER
}

enum InvestmentRange {
  RANGE_50K_100K
  RANGE_100K_200K
  RANGE_200K_PLUS
}

enum ExperienceLevel {
  INVERSOR
  OPERACIONES
  VENTAS
  OTRO
}

enum FranchisePlanTier {
  BASIC
  PLUS
  PRO
}

// ── Landing Page System ─────────────────────────────
enum PlanTier {
  BASIC
  GROWTH
  ALL_IN
}

// ── Lookup Tables ──────────────────────────────────

model Sector {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  emoji      String
  franchises Franchise[]
  leads      Lead[]      @relation("LeadSectors")
  createdAt  DateTime    @default(now())

  @@map("sectors")
}

model Country {
  id                String              @id @default(cuid())
  name              String              @unique
  code              String              @unique
  phoneCode         String
  flag              String
  franchiseCoverage FranchiseCoverage[]
  leads             Lead[]
  createdAt         DateTime            @default(now())

  @@map("countries")
}

// ── Core Models ────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(FRANCHISE_OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Franchise {
  id                String              @id @default(cuid())
  name              String
  description       String
  logo              String?
  video             String?
  investmentMin     Float
  investmentMax     Float
  sectorId          String
  sector            Sector              @relation(fields: [sectorId], references: [id])
  slug              String?             @unique
  contactEmail      String?
  featured          Boolean             @default(false)
  active            Boolean             @default(true)
  coverageCountries FranchiseCoverage[]
  matches           LeadFranchiseMatch[]
  profile           FranchiseProfile?
  featureFlags      FranchiseFeatureFlags?
  botConfig         FranchiseBotConfig?
  botFaqs           FranchiseBotFaq[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // ── Landing Page System (additive) ────────────────
  planTier          PlanTier            @default(BASIC)
  published         Boolean             @default(false)
  headline          String?
  subheadline       String?
  shortDescription  String?
  longDescription   String?
  logoUrl           String?
  heroImageUrl      String?
  youtubeUrl        String?
  brochureUrl       String?
  bookingUrl        String?
  credibilityLine   String?
  cta1Label         String?
  cta1Url           String?
  cta2Label         String?
  cta2Url           String?
  ebitdaReference   String?
  paybackMonths     Int?
  royaltyInfo       String?
  operatorProfile   String?

  businessModels    FranchiseBusinessModel[]
  media             FranchiseMedia[]
  faqs              FranchiseFaq[]
  moduleConfig      FranchiseModuleConfig?
  automationConfig  FranchiseAutomationConfig?

  @@map("franchises")
}

model FranchiseBusinessModel {
  id            String    @id @default(cuid())
  franchiseId   String
  franchise     Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  name          String
  size          String?
  investmentMin Float?
  investmentMax Float?
  ebitda        String?
  paybackMonths Int?
  roiAnnual     Float?
  imageUrl      String?
  description   String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([franchiseId])
  @@map("franchise_business_models")
}

model FranchiseMedia {
  id          String    @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  type        String
  url         String
  label       String?
  altText     String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([franchiseId])
  @@map("franchise_media")
}

model FranchiseFaq {
  id          String    @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  order       Int       @default(0)

  @@index([franchiseId])
  @@map("franchise_faqs")
}

model FranchiseModuleConfig {
  id                    String    @id @default(cuid())
  franchiseId           String    @unique
  franchise             Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  heroEnabled           Boolean   @default(true)
  videoEnabled          Boolean   @default(false)
  galleryEnabled        Boolean   @default(false)
  businessModelsEnabled Boolean   @default(false)
  financialsEnabled     Boolean   @default(true)
  faqEnabled            Boolean   @default(false)
  brochureEnabled       Boolean   @default(false)
  bookingEnabled        Boolean   @default(false)
  chatbotEnabled        Boolean   @default(false)
  nurturingEnabled      Boolean   @default(false)
  showVerifiedBadge     Boolean   @default(false)

  @@map("franchise_module_configs")
}

model FranchiseAutomationConfig {
  id                  String    @id @default(cuid())
  franchiseId         String    @unique
  franchise           Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  enabled             Boolean   @default(false)
  bookingUrl          String?
  nurtureSequenceId   String?
  webhookUrl          String?
  crmDestination      String?
  calendlyRoutingMode String?

  @@map("franchise_automation_configs")
}

model FranchiseProfile {
  id              String    @id @default(uuid())
  franchiseId      String    @unique
  franchise        Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  headline         String    @default("")
  subheadline      String    @default("")
  heroImageUrl     String?
  heroVideoUrl     String?
  galleryUrls      String[]  @default([])
  brochureUrl      String?
  investmentMin    Float?
  investmentMax    Float?
  countryCoverage  String?

  // Hero section
  heroTitle        String?
  heroSubtitle     String?
  heroCtaLabel     String?
  heroStats        Json?

  // Reviews badge
  showReviewsBadge  Boolean   @default(false)
  reviewRating      Float?
  reviewBadgeLabel  String?
  reviewAvatarUrls  Json?

  // Navbar
  showFranchiseLogo Boolean   @default(false)
  franchiseLogoUrl  String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("franchise_profiles")
}

model FranchiseFeatureFlags {
  franchiseId      String            @id
  franchise        Franchise         @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  showVideo        Boolean           @default(false)
  showGallery      Boolean           @default(true)
  showTestimonials Boolean           @default(false)
  showKpis         Boolean           @default(true)
  showBot          Boolean           @default(false)
  showDownloads    Boolean           @default(false)
  showContactForm  Boolean           @default(true)
  planTier         FranchisePlanTier @default(BASIC)
  updatedAt        DateTime          @updatedAt

  @@map("franchise_feature_flags")
}

model FranchiseBotConfig {
  franchiseId         String    @id
  franchise           Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  enabled             Boolean   @default(false)
  systemInstructions  String    @default("")
  fallbackMessage     String    @default("")
  tone                String?
  botMode             String?   @default("guided")
  aiProvider          String?   @default("claude")
  aiModel             String?
  maxMessagesPerConvo Int?      @default(20)
  maxConvosPerMonth   Int?      @default(500)
  updatedAt           DateTime  @updatedAt

  @@map("franchise_bot_configs")
}

model FranchiseBotFaq {
  id          String    @id @default(uuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  priority    Int       @default(0)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([franchiseId])
  @@index([franchiseId, priority])
  @@map("franchise_bot_faqs")
}

model FranchiseCoverage {
  id          String    @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  countryId   String
  country     Country   @relation(fields: [countryId], references: [id])

  @@unique([franchiseId, countryId])
  @@map("franchise_coverage")
}

model Lead {
  id              String          @id @default(cuid())
  name            String
  email           String
  phone           String
  phoneVerified   Boolean         @default(false)
  countryId       String
  country         Country         @relation(fields: [countryId], references: [id])
  sectors         Sector[]        @relation("LeadSectors")
  investmentRange InvestmentRange
  experienceLevel ExperienceLevel
  viewed          Boolean         @default(false)
  matches         LeadFranchiseMatch[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([email])
  @@index([phone])
  @@map("leads")
}

model LeadFranchiseMatch {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  score       Int
  contacted   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([leadId, franchiseId])
  @@map("lead_franchise_matches")
}

// ── Form Leads (landing page qualification form) ────────────────────────────

model FormLead {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  investmentRange String
  city            String?
  experience      String?
  franchiseSlug   String
  landingSource   String   @default("landing-form")
  type            String   @default("form")
  createdAt       DateTime @default(now())

  @@index([franchiseSlug])
  @@index([email])
  @@map("form_leads")
}

model SmsVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  channel   String?  @default("sms")
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sms_verifications")
}
