# Supabase / PostgreSQL
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_FRANCHISES_BUCKET="franchises"

# Twilio Verify (required in production — handles OTP send, expiry, and check)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Legacy (no longer used — replaced by Twilio Verify)
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_STATUS_CALLBACK_BASE_URL=
# TWILIO_WHATSAPP_FROM=

# Resend
RESEND_API_KEY="re_..."
ADMIN_EMAIL="admin@franquiciaslatam.co"

# Admin Auth
JWT_SECRET="your-secret-key-here"

# App URL (used in email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed safety toggle (optional; development default already allowed)
ALLOW_DEV_SEED="false"

# Caso 001 · Stoik Intel x Totto (/totto/caso-001)
# Expediente confidencial. Si se define, la ruta pide este codigo y guarda una
# cookie httpOnly de 12 h. Sin la variable, el enlace queda abierto (siempre
# noindex y no listado).
TOTTO_CASO001_PASSCODE=

# Totto Way (LMS de TOTTO en /totto-way)
# Slug de la franquicia que usa el LMS (por defecto "totto"; lo crea el seed)
TOTTO_WAY_FRANCHISE_SLUG=totto
# Clave de los usuarios demo que crea `npm run seed:totto-way`
TOTTO_WAY_SEED_PASSWORD=totto2026
# Modelos del asistente (fase 3). Ver docs/totto-way/PLAN.md §9
TOTTO_WAY_AI_MODEL=claude-sonnet-5
TOTTO_WAY_AI_MODEL_FAST=claude-haiku-4-5
# Bucket privado de videos/PDFs del LMS (fase 3)
SUPABASE_TOTTO_WAY_BUCKET=totto-way-assets
# Secreto de los jobs programados (Liga nocturna y recordatorios). Vercel Cron
# lo envía como `Authorization: Bearer $CRON_SECRET`. Sin él, solo un ADMIN
# con sesión puede dispararlos.
CRON_SECRET=
# Secretos de las integraciones. El proveedor los manda en `x-totto-way-secret`
# o como `Authorization: Bearer`. Sin secreto configurado el webhook responde
# 503 en vez de quedar abierto.
GEOVICTORIA_WEBHOOK_SECRET=
NPS_WEBHOOK_SECRET=
